HOST=127.0.0.1
PORT=3887
PUBLIC_ORIGIN=http://127.0.0.1:3887
# Run node setup.mjs to generate a local hash. Never use a shared default password.
ADMIN_PASSWORD_HASH=
DATA_DIR=data
# Optional: a server-only GitHub token with the minimum read scope. Never paste it in HTML.
GITHUB_TOKEN=
TRUST_PROXY=0
